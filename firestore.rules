// firestore.rules
rules_version = '2';

service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }
  function isOwner(uid) {
    return request.auth.uid == uid;
  }
  function isAdmin() {
    return isSignedIn() &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
  }

  match /databases/{database}/documents {
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    match /users/{uid} {
      allow read:   if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /organizations/{orgId} {
      allow read:   if true;
      allow create: if isOwner(orgId);
      allow update: if isOwner(orgId);
      allow delete: if isOwner(orgId);
    }

    match /invites/{token} {
      allow read, write: if isAdmin();
      allow read: if true;
    }

    match /requirements/{reqId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.organizationId == request.auth.uid;
    }

    match /slots/{slotId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.organizationId == request.auth.uid;
    }

    match /donations/{donationId} {
      allow read:   if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
    }

    match /donorItems/{itemId} {
      allow read:   if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.donorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.donorId == request.auth.uid;
    }

    match /sponsorshipRequests/{reqId} {
      allow read:   if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
    }

    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

match /vendors/{vendorId} {
      allow read:   if true;
      allow create: if isOwner(vendorId);
      allow update: if isOwner(vendorId) || isSignedIn();
      allow delete: if isSignedIn();
    }

    match /vendorDocuments/{docId} {
      // Allow any signed-in user to read.
      // isAdmin() uses get() which Firestore blocks on collection queries,
      // so we can't use it here. The data is safe — it's only reachable
      // via a vendorId-filtered query from the admin panel.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && resource.data.vendorId == request.auth.uid;
    }

    match /vendorItems/{itemId} {
      allow read:   if true;
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.vendorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.vendorId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read:   if isSignedIn() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid ||
        resource.data.donorId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.donorId == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
